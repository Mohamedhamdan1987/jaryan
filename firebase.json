{
    "hosting": {
        "public": ".",
        "redirects": [
            { "source": "/dammam.html", "destination": "/ahsa.html", "type": 301 }
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "headers": [
            {
                "source": "/jaryan-sewage-web-app-sitemap.xml",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/xml; charset=utf-8"
                    }
                ]
            },
            {
                "source": "**/*.xml",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "application/xml; charset=utf-8"
                    },
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=3600"
                    }
                ]
            },
            {
                "source": "llms.txt",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "text/plain; charset=utf-8"
                    }
                ]
            },
            {
                "source": "robots.txt",
                "headers": [
                    {
                        "key": "Content-Type",
                        "value": "text/plain; charset=utf-8"
                    }
                ]
            }
        ]
    }
}